{
  "model": {
    "name": "Voxel-AI-500M",
    "vocab_size": 32000,
    "d_model": 1536,
    "n_layers": 16,
    "n_heads": 24,
    "n_kv_heads": 8,
    "d_ff": 4096,
    "max_seq_len": 2048,
    "tie_word_embeddings": false,
    "norm_eps": 1e-5,
    "rope_theta": 10000.0,
    "dropout": 0.0,
    "initializer_range": 0.02
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 8,
    "learning_rate": 3e-4,
    "min_lr": 3e-5,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "warmup_steps": 1000,
    "max_steps": 50000,
    "eval_interval": 500,
    "eval_steps": 50,
    "save_interval": 1000,
    "mixed_precision": "auto",
    "gradient_checkpointing": true,
    "seed": 42
  },
  "inference": {
    "temperature": 0.7,
    "top_p": 0.9,
    "top_k": 50,
    "repetition_penalty": 1.15,
    "max_new_tokens": 512,
    "dtype": "float16",
    "device": "cpu"
  },
  "paths": {
    "checkpoint_dir": "checkpoints",
    "tokenizer_dir": "tokenizer",
    "dataset_dir": "dataset/data",
    "drive_checkpoint_dir": "/content/drive/MyDrive/voxel-ai/checkpoints"
  }
}
